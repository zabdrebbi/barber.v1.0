# Supabase — القيم العامة (آمنة في الواجهة، ليست أسراراً)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# بريد الحلاق (يُقرأ في الخادم فقط — Edge Function) ولا يُستخدم في الواجهة
ADMIN_EMAIL=barber@example.com

# اختياري: WhatsApp Cloud API (اتركه فارغاً لاستخدام روابط wa.me المجانية)
VITE_WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# اختياري: Turnstile (جاهز لكن غير مفعّل افتراضياً)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# منفذ التطوير
PORT=5173
